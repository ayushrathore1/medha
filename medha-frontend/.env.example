# Dev uses .env.development → http://localhost:5000
# Production build uses .env.production (or set explicitly):
VITE_BACKEND_URL=https://medharevisionapi.shopcampuskart.in

# Production builds gate the desk to team/admin until general availability
# (see src/config/launch.js for PLATFORM_GA_AT). Opens automatically.
# VITE_FORCE_INSIDE=true     # unlock full desk in a prod build (local override)
# VITE_PLATFORM_OPEN=true    # treat platform as generally available now
# VITE_PLATFORM_TEAM_ONLY=true  # keep gate closed even after GA
