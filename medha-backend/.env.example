# ===========================================
# MEDHA Backend Environment Variables
# Copy this to .env and fill in your values
# ===========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Early access: when NODE_ENV=production, only team/admin can use platform APIs
# until PLATFORM_GA_AT, then everyone is allowed automatically (no manual flip).
# Auth + /api/users/me + /api/team/join stay open so waitlisted users can sign in.
# PLATFORM_GA_AT=2026-11-12T18:00:00+05:30   # 12 Nov 2026, 6:00 PM IST
# PLATFORM_TEAM_ONLY=true   # force gate even after GA / outside production
# PLATFORM_OPEN=true        # disable gate (full public API) even before GA

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/medha?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters

# Hostinger Mail API — https://docs.hostinger.com/emails/mail-api
# Create a token under Agentic Mail → API access (hPanel API tokens will not work).
HOSTINGER_MAIL_API_TOKEN=your-mail-api-token
HOSTINGER_MAIL_API_BASE=https://api.mail.hostinger.com
# Optional. If omitted, sendEmail resolves it from GET /api/v1/me using MAIL_FROM_ADDRESS.
HOSTINGER_MAILBOX_RESOURCE_ID=
MAIL_FROM_ADDRESS=medharevision@codelearnn.com
MAIL_FROM_NAME=Medha Revision
APP_BASE_URL=https://medharevision.shopcampuskart.in

# AI Services
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides (defaults: openai/gpt-oss-120b capable, openai/gpt-oss-20b fast)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_MODERATION_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SERP_API_KEY=your-serpapi-key-for-web-search

# File Storage (ImageKit)
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Cloudinary (for audio/image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Note uploads (PDF / images). Defaults: 25MB, 1 file.
NOTE_UPLOAD_MAX_BYTES=26214400
NOTE_UPLOAD_MAX_FILES=1

# Frontend URL (for CORS)
FRONTEND_URL=https://medharevision.shopcampuskart.in
BACKEND_URL=https://medharevisionapi.shopcampuskart.in

# Optional: ElevenLabs TTS
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
